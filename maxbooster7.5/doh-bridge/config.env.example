# Max Booster DoH Bridge — Environment Config
# Copy to config.env and edit before running setup.sh

# DoH endpoint — your app's DNS-over-HTTPS URL
DOH_URL=https://max-booster.com/api/dns/query

# Bind address and DNS port (53 requires CAP_NET_BIND_SERVICE or root)
LISTEN_IP=0.0.0.0
LISTEN_PORT=53

# HTTP metrics/health endpoint port
METRICS_PORT=9053

# Per-query timeout in ms
QUERY_TIMEOUT_MS=5000

# Retry attempts on DoH failure
MAX_RETRIES=2

# Max concurrent in-flight queries before dropping (prevents OOM)
MAX_PENDING=10000
