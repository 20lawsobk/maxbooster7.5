# ─── Stage 1: Builder ────────────────────────────────────────────────────────
# Installs dependencies and runs build.sh.  The fast path in build.sh detects
# pre-committed dist/ artifacts and runs `npm ci --omit=dev` only, keeping this
# stage lean.  The .dockerignore excludes node_modules/ and .cache/ from the
# COPY context so they are never present in any layer.
FROM node:22 AS builder

WORKDIR /app

COPY . .

RUN bash build.sh

# ─── Stage 2: Production ─────────────────────────────────────────────────────
# Only the minimum runtime artifacts are copied from the builder stage.
# The final image contains no source code, no dev dependencies, no build tools.
FROM node:22-slim AS production

WORKDIR /app

COPY --from=builder /app/dist                                        ./dist
COPY --from=builder /app/node_modules                                ./node_modules
COPY --from=builder /app/package.json                                ./package.json
COPY --from=builder /app/boosterstate/target/release/boosterstate    ./boosterstate/target/release/boosterstate

RUN chmod +x ./boosterstate/target/release/boosterstate

ENV NODE_ENV=production
ENV PORT=5000
ENV BOOSTERSTATE_PORT=9877
ENV UV_THREADPOOL_SIZE=8
ENV TF_NUM_INTEROP_THREADS=2
ENV TF_NUM_INTRAOP_THREADS=2

EXPOSE 5000 9877

CMD ["npm", "run", "start"]
