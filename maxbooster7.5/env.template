# Max Booster 10.0 Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Database (Required)
DATABASE_URL=postgresql://user:password@host:5432/maxbooster?sslmode=require

# Security (Auto-generated by setup script)
SESSION_SECRET=your-32-char-secret-here
JWT_SECRET=your-32-char-jwt-secret-here
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid Email
SENDGRID_API_KEY=SG.xxxxx
FROM_EMAIL=noreply@yourdomain.com

# Meta Facebook
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-long-lived-token

# Google Ads and YouTube
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app.replit.app/api/oauth/google/callback
YOUTUBE_API_KEY=your-youtube-api-key

# Twitter X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Application URLs
CLIENT_URL=https://your-app.replit.app
API_BASE_URL=https://your-app.replit.app/api

# Node Environment
NODE_ENV=production
PORT=5000
