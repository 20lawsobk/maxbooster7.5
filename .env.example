# =============================================================================
# Max Booster — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines marked REQUIRED will cause the server to refuse to start if missing.
# All other variables are optional — features degrade gracefully without them.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE (REQUIRED)
# -----------------------------------------------------------------------------
NODE_ENV=development                          # development | production | test | staging
PORT=5000                                     # HTTP port the server listens on
DATABASE_URL=postgresql://user:pass@host/db   # REQUIRED — Neon/Postgres connection string
SESSION_SECRET=change-me-min-32-chars-xxxxx   # REQUIRED — random string, minimum 32 characters

# -----------------------------------------------------------------------------
# STRIPE — Payments & Subscriptions
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...                 # Stripe secret key (sk_test_... or sk_live_...)
STRIPE_WEBHOOK_SECRET=whsec_...               # Stripe webhook signing secret
STRIPE_CONNECT_CLIENT_ID=ca_...               # Stripe Connect platform client ID
STRIPE_PRICE_ID_PRO_MONTHLY=price_...         # Stripe Price ID for Pro plan (monthly)
STRIPE_PRICE_ID_PRO_ANNUAL=price_...          # Stripe Price ID for Pro plan (annual)
STRIPE_PRICE_ID_ELITE_MONTHLY=price_...       # Stripe Price ID for Elite plan (monthly)
STRIPE_PRICE_ID_ELITE_ANNUAL=price_...        # Stripe Price ID for Elite plan (annual)

# -----------------------------------------------------------------------------
# EMAIL — SendGrid
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG....                       # SendGrid API key for transactional email
SENDGRID_FROM_EMAIL=noreply@yourdomain.com    # Verified sender email address
SENDGRID_WEBHOOK_PUBLIC_KEY=                  # SendGrid webhook verification public key

# -----------------------------------------------------------------------------
# AI / ML SERVICES
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...                         # OpenAI API key (GPT-4, Whisper, etc.)
ANTHROPIC_API_KEY=sk-ant-...                  # Anthropic Claude API key
# MaxCore runs as a LOCAL supervised subsystem by default (external/maxcore).
# MAXCORE_LOCAL=0 restores remote mode via MAXCORE_URL / AI_SERVER_URL.
MAXCORE_LOCAL=1                               # 1 = run MaxCore locally (default), 0 = remote
MAXCORE_LOCAL_PORT=8090                       # Loopback port for the local MaxCore API
AI_SERVER_URL=                                # Remote MaxCore URL (only when MAXCORE_LOCAL=0)
AI_SERVER_KEY=                                # MaxCore generation auth key (optional in local mode)
AI_MODEL_SERVICE_URL=                         # Alternative AI model endpoint

# External AI search
TAVILY_API_KEY=tvly-...                       # Tavily web search API key
EXA_API_KEY=                                  # Exa neural search API key

# -----------------------------------------------------------------------------
# GOOGLE / YOUTUBE — OAuth & APIs
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                             # Google OAuth client ID
GOOGLE_CLIENT_SECRET=                         # Google OAuth client secret
GOOGLE_API_KEY=                               # Google API key (Maps, etc.)
YOUTUBE_CLIENT_ID=                            # YouTube Data API OAuth client ID
YOUTUBE_CLIENT_SECRET=                        # YouTube Data API OAuth client secret
YOUTUBE_API_KEY=                              # YouTube Data API key (public endpoints)
YOUTUBE_ACCESS_TOKEN=                         # YouTube OAuth access token (user-level)
GOOGLE_BUSINESS_CLIENT_ID=                    # Google My Business OAuth client ID
GOOGLE_BUSINESS_CLIENT_SECRET=                # Google My Business OAuth client secret
GOOGLE_MY_BUSINESS_API_KEY=                   # Google My Business API key

# -----------------------------------------------------------------------------
# SOCIAL MEDIA PLATFORMS — OAuth Credentials
# -----------------------------------------------------------------------------

# Twitter / X
TWITTER_API_KEY=                              # Twitter/X app consumer key
TWITTER_API_SECRET=                           # Twitter/X app consumer secret
TWITTER_CLIENT_ID=                            # Twitter/X OAuth 2.0 client ID
TWITTER_CLIENT_SECRET=                        # Twitter/X OAuth 2.0 client secret
TWITTER_ACCESS_TOKEN=                         # Twitter/X app access token
TWITTER_ACCESS_TOKEN_SECRET=                  # Twitter/X app access token secret

# Facebook / Instagram (Meta)
FACEBOOK_APP_ID=                              # Meta app ID
FACEBOOK_APP_SECRET=                          # Meta app secret
INSTAGRAM_APP_ID=                             # Instagram Basic Display API app ID
INSTAGRAM_ACCESS_TOKEN=                       # Instagram access token

# TikTok
TIKTOK_ENV=sandbox                            # sandbox | production
TIKTOK_CLIENT_KEY=                            # TikTok app client key
TIKTOK_CLIENT_SECRET=                         # TikTok app client secret
TIKTOK_ACCESS_TOKEN=                          # TikTok access token
TIKTOK_SANDBOX_CLIENT_KEY=                    # TikTok sandbox client key
TIKTOK_SANDBOX_CLIENT_SECRET=                 # TikTok sandbox client secret
TIKTOK_SANDBOX_REDIRECT_URI=                  # TikTok sandbox redirect URI
TIKTOK_SANDBOX_SCOPES=                        # TikTok sandbox OAuth scopes (comma-separated)
TIKTOK_PROD_CLIENT_KEY=                       # TikTok production client key
TIKTOK_PROD_CLIENT_SECRET=                    # TikTok production client secret
TIKTOK_PROD_REDIRECT_URI=                     # TikTok production redirect URI
TIKTOK_PROD_SCOPES=                           # TikTok production OAuth scopes

# Threads
THREADS_APP_ID=                               # Threads app ID
THREADS_APP_SECRET=                           # Threads app secret
THREADS_ACCESS_TOKEN=                         # Threads access token
THREADS_REDIRECT_URI=                         # Threads OAuth redirect URI

# LinkedIn
LINKEDIN_CLIENT_ID=                           # LinkedIn app client ID
LINKEDIN_CLIENT_SECRET=                       # LinkedIn app client secret
LINKEDIN_ACCESS_TOKEN=                        # LinkedIn access token

# SoundCloud
SOUNDCLOUD_CLIENT_ID=                         # SoundCloud app client ID

# Tidal
TIDAL_TOKEN=                                  # Tidal API token

# -----------------------------------------------------------------------------
# MUSIC DISTRIBUTION — LabelGrid
# -----------------------------------------------------------------------------
LABELGRID_API_URL=https://api.labelgrid.com   # LabelGrid API base URL
LABELGRID_API_KEY=                            # LabelGrid API key
LABELGRID_API_SECRET=                         # LabelGrid API secret
LABELGRID_API_TOKEN=                          # LabelGrid bearer token
LABELGRID_ENV=sandbox                         # sandbox | production
LABELGRID_WEBHOOK_SECRET=                     # LabelGrid webhook verification secret
LABELGRID_WEBHOOK_URL=                        # Your endpoint for LabelGrid webhooks

# Spotify (for analytics/linking — not distribution)
SPOTIFY_CLIENT_ID=                            # Spotify app client ID
SPOTIFY_CLIENT_SECRET=                        # Spotify app client secret

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS — Web Push (VAPID) & Firebase
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=                             # Web Push VAPID public key
VAPID_PRIVATE_KEY=                            # Web Push VAPID private key
VAPID_SUBJECT=mailto:admin@yourdomain.com     # Web Push VAPID subject (mailto: or https:)
FCM_PROJECT_ID=                               # Firebase project ID
FCM_SERVER_KEY=                               # Firebase Cloud Messaging server key
FCM_CLIENT_EMAIL=                             # Firebase service account email
FCM_SERVICE_ACCOUNT_KEY=                      # Firebase service account JSON (base64 or path)

# -----------------------------------------------------------------------------
# AWS — File Storage (if not using Replit Object Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=                            # AWS access key ID
AWS_SECRET_ACCESS_KEY=                        # AWS secret access key
AWS_REGION=us-east-1                          # AWS region
STORAGE_PROVIDER=replit                       # replit | s3 | local
CDN_ENABLED=false                             # Enable CDN for static assets
CDN_BASE_URL=                                 # CDN base URL (e.g. https://cdn.yourdomain.com)
CDN_PROVIDER=                                 # CDN provider slug
CDN_PURGE_API_KEY=                            # CDN cache purge API key
CDN_PURGE_ENDPOINT=                           # CDN cache purge endpoint URL

# -----------------------------------------------------------------------------
# REDIS / BULLMQ — Job Queue & Caching
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379              # Redis connection URL (optional; in-memory if absent)
BULLMQ_CONCURRENCY=5                          # BullMQ worker concurrency

# -----------------------------------------------------------------------------
# DOMAIN & DNS
# -----------------------------------------------------------------------------
BASE_DOMAIN=yourdomain.com                    # Root domain for the platform
BASE_URL=https://yourdomain.com               # Full public base URL
APP_URL=https://yourdomain.com                # Alias for BASE_URL
SITE_URL=https://yourdomain.com               # Alias used by email links
STOREFRONT_URL_FORMAT=https://{slug}.yourdomain.com  # Artist storefront URL pattern
DOMAIN=yourdomain.com                         # Domain alias
CORS_ORIGIN=                                  # Allowed CORS origins (comma-separated; defaults to BASE_URL)

# GeoDNS
# Sign up free at https://www.maxmind.com/en/geolite2/signup then generate a license key.
# Run: bash scripts/download-geodb.sh  to fetch the binary database.
MAXMIND_ACCOUNT_ID=                           # MaxMind account ID (free)
MAXMIND_LICENSE_KEY=                          # MaxMind license key (free)
MAXMIND_EDITION=GeoLite2-Country              # GeoLite2-Country (small) or GeoLite2-City (large)
GEODB_PATH=./data/GeoLite2-Country.mmdb       # Path to downloaded MaxMind .mmdb file
GEODNS_ENABLED=false                          # Enable GeoDNS routing
REGION_NAME=us-east                           # This instance's region name
REGION_MAP=                                   # JSON map of region → IP list
DNS_SERVER_IP=                                # DNS server bind IP
DNS_PORT=53                                   # DNS server port
DNS_SERVER_ROLE=primary                       # primary | secondary | resolver
DNSSEC_ENABLED=false                          # Enable DNSSEC signing
DOH_UPSTREAM=https://cloudflare-dns.com/dns-query  # DNS-over-HTTPS upstream

# -----------------------------------------------------------------------------
# ACME / TLS — Automatic Certificate Management
# -----------------------------------------------------------------------------
ACME_ENABLED=false                            # Enable automatic TLS via Let's Encrypt
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_CONTACT_EMAIL=admin@yourdomain.com       # Let's Encrypt account email
ACME_KEY_ENCRYPTION_KEY=                      # Key used to encrypt stored ACME private keys
TLS_CERT_PATH=                                # Path to TLS certificate (if not using ACME)

# -----------------------------------------------------------------------------
# ADMIN ACCOUNT — Initial Setup
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com              # Seeded admin account email
ADMIN_USERNAME=admin                          # Seeded admin account username
ADMIN_PASSWORD=                               # Seeded admin account password (min 12 chars)
ADMIN_USER_IDS=                               # Comma-separated user IDs with admin role

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=                         # 32-byte hex key for encrypting stored OAuth tokens
SECRET_KEY=                                   # General-purpose secret (fallback for TOKEN_ENCRYPTION_KEY)
WEBHOOK_SECRET=                               # Generic inbound webhook verification secret
HCAPTCHA_SECRET_KEY=                          # hCaptcha secret key (for bot protection)
RECAPTCHA_SECRET_KEY=                         # reCAPTCHA secret key

# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------
SESSION_NAME=sessionId                        # Cookie name for session (default: sessionId)
SESSION_MAX_AGE=86400000                      # Session TTL in milliseconds (default: 24h)

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true                       # Master switch for all rate limiters
RATE_LIMIT_GLOBAL_IP=100                      # Requests per minute per IP (unauthenticated)
RATE_LIMIT_GLOBAL_USER=300                    # Requests per minute per user (authenticated)
RATE_LIMIT_AI=20                              # Requests per minute for AI endpoints
RATE_LIMIT_BILLING=10                         # Requests per minute for billing endpoints
RATE_LIMIT_UPLOADS=30                         # Requests per minute for file uploads
RATE_LIMIT_PAYOUTS=5                          # Requests per minute for payout requests
RATE_LIMIT_KYC=5                              # Requests per minute for KYC endpoints

# -----------------------------------------------------------------------------
# MONITORING & ALERTING
# -----------------------------------------------------------------------------
LOG_LEVEL=info                                # Logger level: trace | debug | info | warn | error
SENTRY_DSN=                                   # Sentry DSN for error tracking
ALERT_WEBHOOK_URL=                            # Slack/Discord/PagerDuty webhook for alerts
ALERT_EMAIL_RECIPIENTS=                       # Comma-separated alert email recipients
ALERT_MEMORY_MAX_MB=1500                      # Alert threshold: heap memory in MB
ALERT_ERROR_RATE_MAX=0.05                     # Alert threshold: error rate fraction (0.05 = 5%)
ALERT_QUEUE_MAX_WAITING=500                   # Alert threshold: BullMQ jobs waiting
ALERT_QUEUE_MAX_FAILED=50                     # Alert threshold: BullMQ jobs failed
ALERT_QUEUE_MAX_LATENCY=30000                 # Alert threshold: queue latency in ms
ALERT_AI_CACHE_MAX_UTIL=0.9                   # Alert threshold: AI cache utilization fraction

# -----------------------------------------------------------------------------
# CLUSTER / SCALING
# -----------------------------------------------------------------------------
ENABLE_CLUSTER=false                          # Enable Node.js cluster mode
DISABLE_CLUSTER=false                         # Force single-process mode (overrides ENABLE_CLUSTER)
CLUSTER_WORKERS=                              # Number of cluster workers (default: CPU count)
SCALE_MIN_REPLICAS=1                          # Auto-scaler minimum replicas
SCALE_MAX_REPLICAS=8                          # Auto-scaler maximum replicas
SCALE_CPU_UP=0.75                             # CPU utilization threshold to scale up
SCALE_CPU_DOWN=0.3                            # CPU utilization threshold to scale down
SCALE_MEMORY_UP=0.8                           # Memory utilization threshold to scale up
SCALE_MEMORY_DOWN=0.4                         # Memory utilization threshold to scale down
SCALE_LATENCY_THRESHOLD=2000                  # P95 latency threshold (ms) to scale up
SCALE_ERROR_RATE=0.01                         # Error rate threshold to scale up
SCALE_COOLDOWN=300                            # Seconds between scaling actions

# -----------------------------------------------------------------------------
# DATABASE POOL
# -----------------------------------------------------------------------------
DB_MAX_POOL_SIZE=20                           # Maximum DB connection pool size
DB_IDLE_TIMEOUT=30000                         # Idle connection timeout in ms
DB_CONNECTION_TIMEOUT=5000                    # Connection acquisition timeout in ms
DATABASE_REPLICA_URLS=                        # Comma-separated read-replica URLs
DATA_RETENTION_DAYS=365                       # Days to retain analytics/log data

# -----------------------------------------------------------------------------
# POCKET DIMENSION (PDIM) — Internal State Sidecar
# -----------------------------------------------------------------------------
PDIM_EXEC_URL=                                # PDIM execution URL
PDIM_HTTP_EXEC_URL=                           # PDIM HTTP execution URL
PDIM_EXEC_TOKEN=                              # PDIM execution auth token
PDIM_BEARER_TOKEN=                            # PDIM bearer token
PDIM_CLUSTER_WORKERS=1                        # PDIM worker count
BOOSTERSTATE_SECRET=                          # BoosterState shared secret
BOOSTERSTATE_SIDECAR_PORT=7777                # BoosterState sidecar port
BOOSTERSTATE_DATA_DIR=./boosterstate/data     # BoosterState data directory

# -----------------------------------------------------------------------------
# VIDEO / MEDIA PROCESSING
# -----------------------------------------------------------------------------
VIDEO_DIFFUSION_URL=http://localhost:8008      # AI video diffusion service URL
VIDEO_DIFFUSION_PORT=8008                     # AI video diffusion service port
FFMPEG_PATH=                                  # Custom path to ffmpeg binary (auto-detected if blank)
PYTHON_PATH=                                  # Custom path to Python binary
PYTHON_AI_PORT=8009                           # Python AI service port
MAX_CONCURRENT_REQUESTS=10                    # Max concurrent AI/media processing requests

# -----------------------------------------------------------------------------
# PLATFORM FEATURES
# -----------------------------------------------------------------------------
AUTONOMOUS_MODE=false                         # Enable fully autonomous AI autopilot
ENABLE_SELF_EVOLUTION=false                   # Enable AI self-improvement mode
PLATFORM_FEE_PERCENTAGE=10                    # Platform fee on marketplace sales (percent)
LOAD_TEST_MODE=false                          # Disable certain guards during load tests
BUILD_ID=                                     # Current deployment build ID (set by CI)

# -----------------------------------------------------------------------------
# HANDSHAKE / HNS — Decentralized DNS (optional)
# -----------------------------------------------------------------------------
HNS_NETWORK=mainnet                           # mainnet | simnet
HNS_HOST=localhost                            # HSD node host
HNS_PORT=12037                                # HSD API port
HNS_API_KEY=                                  # HSD API key
HNS_WALLET=default                            # HSD wallet name
HNS_TIMEOUT=10000                             # HSD request timeout in ms

# EPP (Domain Registration Protocol)
EPP_HOST=                                     # EPP registrar host
EPP_PORT=700                                  # EPP port
EPP_USERNAME=                                 # EPP username
EPP_PASSWORD=                                 # EPP password
EPP_TLS_CERT=                                 # Path to EPP TLS client cert
EPP_TLS_KEY=                                  # Path to EPP TLS client key

# Registrar
REGISTRAR_PROVIDER=                           # Domain registrar provider slug

# -----------------------------------------------------------------------------
# REPLIT PLATFORM (auto-set by Replit — do not set manually)
# -----------------------------------------------------------------------------
# REPLIT_DEPLOYMENT=1                         # Set by Replit when deployed
# REPLIT_DEV_DOMAIN=                          # Set by Replit for dev preview domain
# REPLIT_DOMAINS=                             # Set by Replit for all domains
# REPLIT_DEPLOYMENT_URL=                      # Set by Replit deployment URL
# REPLIT_BUCKET_ID=                           # Set by Replit object storage bucket ID
# REPL_ID=                                    # Set by Replit
# REPL_SLUG=                                  # Set by Replit
# REPL_OWNER=                                 # Set by Replit
