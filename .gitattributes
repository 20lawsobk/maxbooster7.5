# ── Binary file markers ────────────────────────────────────────────────────────
# Prevents git from treating binary content as text (line-ending conversion,
# UTF-8 validation) and prevents Replit's deployment layer from failing with
# "invalid UTF-8" when scanning these files.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.wal    binary
*.bin    binary
*.so     binary
*.dylib  binary
*.br     binary
*.gz     binary
hardware/digital_gpu_core/flow/gpu_core_cts.odb filter=lfs diff=lfs merge=lfs -text
hardware/digital_gpu_core/flow/gpu_core_placed.odb filter=lfs diff=lfs merge=lfs -text
hardware/digital_gpu_core/flow/gpu_core_globalroute.odb filter=lfs diff=lfs merge=lfs -text
