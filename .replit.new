mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --daemonize yes --port 6379 --loglevel warning --save '' --appendonly no && sleep 1 && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

