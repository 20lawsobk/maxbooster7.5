// conv2dim2colwmma_optimized.cu
// Optimized conv2d via im2col + WMMA with better tiling and memory access

include <cuda_fp16.h>

include <cuda_runtime.h>

include <mma.h>

using namespace nvcuda;

define WARP_SIZE 32

global void im2colsm102optimized(
    const half* restrict x,
    half* restrict cols,
    int N, int C, int H, int W,
    int K, int stride, int padding,
    int outh, int outw
) {
    int n = blockIdx.x;
    int c = blockIdx.y;
    int idx = blockIdx.z * blockDim.x + threadIdx.x;
    int total = outh * outw;
    if (idx >= total) return;

    int oh = idx / out_w;
    int ow = idx % out_w;

    int h_start = oh * stride - padding;
    int w_start = ow * stride - padding;

    int base_col = (n  (C  K  K) + c  K  K)  total + idx;

    for (int kh = 0; kh < K; ++kh) {
        int h = h_start + kh;
        bool h_valid = (h >= 0 && h < H);
        for (int kw = 0; kw < K; ++kw) {
            int w = w_start + kw;
            int colidx = basecol + (kh  K + kw)  total;
            if (h_valid && w >= 0 && w < W) {
                int x_idx = ((n  C + c)  H + h) * W + w;
                cols[colidx] = x[xidx];
            } else {
                cols[colidx] = _float2half(0.0f);
            }
        }
    }
}

global void convwmmasm102_optimized(
    const half* restrict A,   // (M x K)
    const half* restrict B,   // (K x N)
    half* restrict C,         // (M x N)
    int M, int N, int K
) {
    int warpM = (blockIdx.x * blockDim.x + threadIdx.x) / WARP_SIZE;
    int warpN = blockIdx.y * blockDim.y + threadIdx.y;

    int row = warpM * 16;
    int col = warpN * 16;

    if (row >= M || col >= N) return;

    wmma::fragment<wmma::matrixa, 16, 16, 16, half, wmma::rowmajor> a_frag;
    wmma::fragment<wmma::matrixb, 16, 16, 16, half, wmma::colmajor> b_frag;
    wmma::fragment<wmma::accumulator, 16, 16, 16, half> c_frag;

    wmma::fillfragment(cfrag, float2half(0.0f));

    for (int k0 = 0; k0 < K; k0 += 16) {
        const half a_tile = A + row  K + k0;
        const half b_tile = B + col  K + k0;

        wmma::loadmatrixsync(afrag, atile, K);
        wmma::loadmatrixsync(bfrag, btile, K);

        wmma::mmasync(cfrag, afrag, bfrag, c_frag);
    }

    half c_tile = C + row  N + col;
    wmma::storematrixsync(ctile, cfrag, N, wmma::memrowmajor);
}
