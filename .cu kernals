Optimized digital GPU kernels (NumPy) for FlashAttention and conv2d

from future import annotations
import numpy as np
from typing import Dict, Any
from .precision import dequantize_fp8


def flashattentionfp8_optimized(
    Q_fp8: np.ndarray,
    K_fp8: np.ndarray,
    V_fp8: np.ndarray,
    fmt: str = "e4m3",
    causal: bool = False,
) -> np.ndarray:
    B, H, T, D = Q_fp8.shape
    Q = dequantizefp8(Qfp8, fmt).astype(np.float32)
    K = dequantizefp8(Kfp8, fmt).astype(np.float32)
    V = dequantizefp8(Vfp8, fmt).astype(np.float32)

    scale = 1.0 / np.sqrt(D)
    scores = np.einsum("bhtd,bhtd->bhtt", Q, K) * scale

    if causal:
        mask = np.triu(np.ones((T, T), dtype=bool), k=1)
        scores = np.where(mask[None, None, :, :], -np.inf, scores)

    scores = scores - scores.max(axis=-1, keepdims=True)
    weights = np.exp(scores)
    weights /= weights.sum(axis=-1, keepdims=True)

    O = np.einsum("bhtt,bhtd->bhtd", weights, V.astype(np.float16)).astype(np.float16)
    return O


def conv2d_optimized(
    x: np.ndarray,
    w: np.ndarray,
    stride: int = 1,
    padding: int = 0,
) -> np.ndarray:
    N, C, H, W = x.shape
    F, _, KH, KW = w.shape
    out_h = (H + 2 * padding - KH) // stride + 1
    out_w = (W + 2 * padding - KW) // stride + 1

    x_pad = np.pad(x, ((0, 0), (0, 0), (padding, padding), (padding, padding)))
    cols = np.zeros((N, C  KH  KW, outh * outw), dtype=x.dtype)

    idx = 0
    for oh in range(out_h):
        for ow in range(out_w):
            h_start = oh * stride
            w_start = ow * stride
            patch = xpad[:, :, hstart:hstart + KH, wstart:w_start + KW]
            cols[:, :, idx] = patch.reshape(N, C  KH  KW)
            idx += 1

    w_mat = w.reshape(F, C  KH  KW)
    y = np.einsum("fc,nck->nfk", w_mat, cols)
    return y.reshape(N, F, outh, outw)
