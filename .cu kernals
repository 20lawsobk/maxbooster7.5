// flashattentionsm102_optimized.cu
// Optimized FP8 FlashAttention kernel with tiling, shared memory, and warp-level softmax

include <cuda_fp16.h>

include <cuda_runtime.h>

define WARP_SIZE 32

define FP8_E4M3 0

define FP8_E5M2 1

struct fp8_e4m3 { unsigned char v; };
struct fp8_e5m2 { unsigned char v; };

device forceinline float fp8e4m3tofloat(fp8e4m3 x) {
    int i = static_cast<int>(x.v);
    if (i & 0x80) i |= ~0xFF;
    return static_cast<float>(i) / 16.0f;
}

device forceinline float fp8e5m2tofloat(fp8e5m2 x) {
    int i = static_cast<int>(x.v);
    if (i & 0x80) i |= ~0xFF;
    return static_cast<float>(i) / 8.0f;
}

template<int FP8FORMAT, int TILET, int TILE_D>
global void flashattnsm102_optimized(
    const void* restrict Q,
    const void* restrict K,
    const void* restrict V,
    half* restrict O,
    int B, int H, int T, int D,
    bool causal
) {
    extern shared float smem[];
    float* scorestile = smem;                      // TILET x TILE_T
    float mi = scorestile + TILET  TILET;     // TILE_T
    float* li = mi + TILET;                      // TILET
    float* acc = li + TILET;                      // TILE_T x D

    int bh = blockIdx.x;
    int b = bh / H;
    int h = bh % H;

    int tid = threadIdx.x;
    int lane = tid % WARP_SIZE;

    int qbase = blockIdx.y * TILET;
    if (q_base >= T) return;

    // init per-row stats and accumulator
    if (lane < TILE_T) {
        m_i[lane] = -INFINITY;
        l_i[lane] = 0.0f;
        for (int d = 0; d < D; ++d) {
            acc[lane * D + d] = 0.0f;
        }
    }
    syncthreads();

    float scale = 1.0f / sqrtf((float)D);

    // iterate over key blocks
    for (int kbase = 0; kbase < T; kbase += TILET) {
        int qidx = qbase + lane;
        int kidx = kbase + threadIdx.y;

        // compute partial scores for this tile
        if (lane < TILET && threadIdx.y < TILET && qidx < T && kidx < T) {
            float dot = 0.0f;
            for (int d0 = 0; d0 < D; d0 += TILE_D) {
                for (int d = d0; d < d0 + TILE_D && d < D; ++d) {
                    int qoff = (((b  H + h)  T + qidx) * D + d);
                    int koff = (((b  H + h)  T + kidx) * D + d);
                    float qv, kv;
                    if constexpr (FP8FORMAT == FP8E4M3) {
                        fp8e4m3 q8 = reinterpretcast<const fp8e4m3*>(Q)[qoff];
                        fp8e4m3 k8 = reinterpretcast<const fp8e4m3*>(K)[koff];
                        qv = fp8e4m3to_float(q8);
                        kv = fp8e4m3to_float(k8);
                    } else {
                        fp8e5m2 q8 = reinterpretcast<const fp8e5m2*>(Q)[qoff];
                        fp8e5m2 k8 = reinterpretcast<const fp8e5m2*>(K)[koff];
                        qv = fp8e5m2to_float(q8);
                        kv = fp8e5m2to_float(k8);
                    }
                    dot += qv * kv;
                }
            }
            float score = dot * scale;
            if (causal && qidx < kidx) score = -INFINITY;
            scorestile[lane * TILET + threadIdx.y] = score;
        }
        syncthreads();

        // warp-level softmax update per row
        if (lane < TILET && qbase + lane < T) {
            float row_max = -INFINITY;
            for (int n = 0; n < TILET && kbase + n < T; ++n) {
                float s = scorestile[lane * TILET + n];
                rowmax = fmaxf(rowmax, s);
            }
            float mnew = fmaxf(mi[lane], row_max);
            float expmdiff = expf(mi[lane] - mnew);

            float lnew = expmdiff * li[lane];
            for (int n = 0; n < TILET && kbase + n < T; ++n) {
                float s = scorestile[lane * TILET + n];
                float e = expf(s - m_new);
                l_new += e;

                int voff = (((b  H + h)  T + (kbase + n)) * D);
                for (int d = 0; d < D; ++d) {
                    float vv;
                    if constexpr (FP8FORMAT == FP8E4M3) {
                        fp8e4m3 v8 = reinterpretcast<const fp8e4m3*>(V)[voff + d];
                        vv = fp8e4m3to_float(v8);
                    } else {
                        fp8e5m2 v8 = reinterpretcast<const fp8e5m2*>(V)[voff + d];
                        vv = fp8e5m2to_float(v8);
                    }
                    float old = acc[lane * D + d];
                    acc[lane  D + d] = (expmdiff  li[lane]  old + e  vv) / lnew;
                }
            }
            mi[lane] = mnew;
            li[lane] = lnew;
        }
        syncthreads();
    }

    // write back
    if (lane < TILET && qbase + lane < T) {
        int qglobal = qbase + lane;
        for (int d = 0; d < D; ++d) {
            int ooff = (((b  H + h)  T + qglobal) * D + d);
            O[ooff] = _float2half(acc[lane * D + d]);
        }
    }
}
