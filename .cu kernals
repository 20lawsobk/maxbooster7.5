// reductionsm102optimized.cu
// Optimized reduction with full warp utilization and block-level accumulation

include <cuda_runtime.h>

define WARP_SIZE 32

inline device float warpreducesum_opt(float val) {
    for (int offset = WARP_SIZE / 2; offset > 0; offset >>= 1) {
        val += shfldownsync(0xffffffff, val, offset);
    }
    return val;
}

global void reductionsm102optimized(
    const float* restrict x,
    const float* restrict y,
    float* restrict out,
    int n
) {
    extern shared float sdata[];
    int tid = threadIdx.x;
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int stride = blockDim.x * gridDim.x;

    float sum = 0.0f;
    for (int i = idx; i < n; i += stride) {
        sum += x[i] * y[i];
    }

    sum = warpreducesum_opt(sum);

    if ((tid & (WARP_SIZE - 1)) == 0) {
        sdata[tid / WARP_SIZE] = sum;
    }
    syncthreads();

    int numwarps = blockDim.x / WARPSIZE;
    if (tid < num_warps) {
        float block_sum = sdata[tid];
        blocksum = warpreducesumopt(block_sum);
        if (tid == 0) {
            atomicAdd(out, block_sum);
        }
    }
}
