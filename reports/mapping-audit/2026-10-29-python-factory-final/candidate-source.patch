+assert rows[0]['runtimeAvailability'] == 'UNVERIFIED'
+assert hasattr(module, '_JUNIT') and hasattr(module, '_FACTORY')
+print(json.dumps({'rows': len(rows), 'path': rows[0]['path'], 'pairedHelpers': True}))
