{
  "name": "@max-booster/dns-node",
  "version": "3.0.0",
  "description": "Max Booster — Standalone authoritative DNS nameserver node",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev":   "tsx src/index.ts",
    "ns1":   "DNS_PORT=5353 DNS_SERVER_ROLE=ns1 HEALTH_PORT=5380 tsx src/index.ts",
    "ns2":   "DNS_PORT=5354 DNS_SERVER_ROLE=ns2 HEALTH_PORT=5381 tsx src/index.ts"
  },
  "keywords": ["dns", "nameserver", "authoritative", "dnssec", "geodns"],
  "license": "MIT"
}
