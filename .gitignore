# Rust build artifacts — all compiled output is rebuilt during deployment.
# The binary was previously committed but caused Replit's deployment layer
# push to fail with "invalid UTF-8". cargo build runs in build.sh instead.
boosterstate/target/

# Binary files that CANNOT be committed to git — Replit's deployment layer
# push rejects non-UTF-8 (binary) content with "invalid UTF-8".
# All binary assets are copied at build time by build.sh before client/ is deleted.

# Pre-compressed assets — brotli (.br) and gzip (.gz) are generated at build time.
dist/public/assets/*.br
dist/public/assets/*.gz
dist/public/**/*.br
dist/public/**/*.gz
client/dist/public/

# Binary image assets — PNG/WebP/ICO/JPG files are binary and must NOT be in git.
# Replit's deployment layer push rejects non-UTF-8 (binary) files.
dist/public/favicon.png
dist/public/favicon16.png
dist/public/favicon.ico
dist/public/logo.png
dist/public/logo.webp
dist/public/icons/
dist/public/screenshots/
# Source-tree binary assets (also excluded by .dockerignore via client/ + assets/)
client/public/favicon.png
client/public/favicon16.png
client/public/favicon.ico
client/public/logo.webp
client/public/icons/
assets/images/
# Root-level and public/ binary image assets
generated-icon.png
public/favicon.png
public/favicon.ico
public/*.png
public/*.jpg
public/*.webp

# Videos and large media (binary, served from object storage / CDN instead)
dist/public/videos/
client/dist/public/videos/
client/public/screenshots/
client/public/videos/
.github-runner/

# Cloudflare tunnel credentials
.cloudflared/*.json
.cloudflared/cert.pem

# Security auto-fix: required gitignore entries
.env.production
.env.staging
*.pem
*.p12
*.pfx
service-account*.json
.config/

# Security auto-fix: required entries
.env.development

# Nix build artifacts — nix-build creates a "result" symlink pointing to a Nix
# store path containing ELF binaries. Replit's deployment Repl layer push fails
# with "invalid UTF-8" if it follows the symlink to binary executable content.
result

# Portable Node.js binary downloaded by build.sh for deployment run container
.node_bin/

# Compiled boosterstate sidecar binary — pre-compiled for deployment.
# !bin/boosterstate is explicitly allowed so the pre-built binary travels with the project.
# build.sh also recompiles it from source if cargo is available in the build environment.
bin/*
!bin/boosterstate

# Python virtual environment created by build.sh for deployment run container
python_runtime/

# PDIM capsule artifacts — created by build.sh, restored on first startup
# These are large binary compressed archives (node_modules + python_runtime)
*.pdim
*.manifest.json
node_modules.pdim
python_runtime.pdim

# Diffusion model training shards — runtime-generated by api_server_v4.py
# These belong in the PDIM storage layer (HybridStorage), not in source control.
# The Python API regenerates them from training data at runtime.
server/services/diffusion/advanced_memory/
services/diffusion/advanced_memory/
*.npz
