from future import annotations
import numpy as np

class DigitalDNN:
    def conv2d(self, x: np.ndarray, w: np.ndarray, stride: int = 1, padding: int = 0) -> np.ndarray:
        N, C, H, W = x.shape
        F, _, KH, KW = w.shape
        out_h = (H + 2 * padding - KH) // stride + 1
        out_w = (W + 2 * padding - KW) // stride + 1
        y = np.zeros((N, F, outh, outw), dtype=x.dtype)
        x_pad = np.pad(x, ((0, 0), (0, 0), (padding, padding), (padding, padding)))
        for n in range(N):
            for f in range(F):
                for oh in range(out_h):
                    for ow in range(out_w):
                        h0 = oh * stride
                        w0 = ow * stride
                        patch = x_pad[n, :, h0:h0+KH, w0:w0+KW]
                        y[n, f, oh, ow] = np.sum(patch * w[f])
        return y
