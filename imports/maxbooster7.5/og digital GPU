from future import annotations
import time
import numpy as np
from typing import Dict, Any
from .telemetry import Telemetry
from .precision import fp8mixedmatmul
from .opcode_spec import OPCODES
from .errors import ShapeMismatchError, InvalidOpcodeError, DigitalGPUError

class DigitalGPU:
    def init(self) -> None:
        self._vram: Dict[str, np.ndarray] = {}
        self.telemetry = Telemetry()

    def alloc(self, name: str, shape, dtype=np.float32) -> None:
        if name in self._vram:
            raise DigitalGPUError(f"Tensor '{name}' already allocated.")
        self._vram[name] = np.zeros(shape, dtype=dtype)

    def free(self, name: str) -> None:
        if name in self._vram:
            del self._vram[name]

    def get(self, name: str) -> np.ndarray:
        return self._vram[name]

    def run_kernel(self, opcode: str, inputs: Dict[str, Any]) -> Dict[str, Any]:
        if opcode not in OPCODES:
            raise InvalidOpcodeError(opcode)
        spec = OPCODES[opcode]
        start = time.time()

        if opcode == "flashattentionfp8_sm102:v1":
            Q = inputs["Q"]
            K = inputs["K"]
            V = inputs["V"]
            if Q.shape != K.shape or Q.shape != V.shape:
                raise ShapeMismatchError("Q, K, V must have identical shapes.")
            scores = fp8mixedmatmul(Q, K.transpose(0, 1, 3, 2), "e4m3")
            scores = scores - scores.max(axis=-1, keepdims=True)
            weights = np.exp(scores)
            weights /= weights.sum(axis=-1, keepdims=True)
            O = (weights @ V.astype(np.float16)).astype(np.float16)
            end = time.time()
            bytes_moved = Q.nbytes + K.nbytes + V.nbytes + O.nbytes
            flops = float(Q.size * K.shape[-1])
            self.telemetry.record(opcode, start, end, bytes_moved, flops)
            return {"O": O}

        raise InvalidOpcodeError(opcode)
