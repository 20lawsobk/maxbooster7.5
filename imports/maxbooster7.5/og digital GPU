// flashattentionsm102.cu

include <cuda_fp16.h>

include <cuda_runtime.h>

include <mma.h>

using namespace nvcuda;

define WARP_SIZE 32

define FP8_E4M3 0

define FP8_E5M2 1

struct fp8_e4m3 {
    unsigned char v;
};

struct fp8_e5m2 {
    unsigned char v;
};

device forceinline fp8e4m3 floattofp8e4m3(float x) {
    int i = float2int_rn(x * 16.0f);
    i = max(-128, min(127, i));
    fp8_e4m3 r;
    r.v = static_cast<unsigned char>(i & 0xFF);
    return r;
}

device forceinline fp8e5m2 floattofp8e5m2(float x) {
    int i = float2int_rn(x * 8.0f);
    i = max(-128, min(127, i));
    fp8_e5m2 r;
    r.v = static_cast<unsigned char>(i & 0xFF);
    return r;
}

device forceinline float fp8e4m3tofloat(fp8e4m3 x) {
    int i = static_cast<int>(x.v);
    if (i & 0x80) i |= ~0xFF;
    return static_cast<float>(i) / 16.0f;
}

device forceinline float fp8e5m2tofloat(fp8e5m2 x) {
    int i = static_cast<int>(x.v);
    if (i & 0x80) i |= ~0xFF;
    return static_cast<float>(i) / 8.0f;
}

template<int FP8_FORMAT>
global void flashattnsm102_kernel(
    const void* restrict Q,
    const void* restrict K,
    const void* restrict V,
    half* restrict O,
    int B, int H, int T, int D,
    bool causal
) {
    extern shared float shared[];
    float* m_i = shared;
    float* li = mi + T;
    float* acc = l_i + T;

    int bh = blockIdx.x;
    int b = bh / H;
    int h = bh % H;

    int tid = threadIdx.x;
    int laneid = tid % WARPSIZE;

    if (lane_id < T) {
        mi[laneid] = -INFINITY;
        li[laneid] = 0.0f;
        for (int d = 0; d < D; ++d) {
            acc[lane_id * D + d] = 0.0f;
        }
    }
    syncthreads();

    float scale = 1.0f / sqrtf((float)D);

    for (int kblock = 0; kblock < T; ++k_block) {
        int qidx = laneid;
        int kidx = kblock;

        float score = -INFINITY;
        if (qidx < T && kidx < T) {
            float dot = 0.0f;
            for (int d = 0; d < D; ++d) {
                int qoff = (((b  H + h)  T + qidx) * D + d);
                int koff = (((b  H + h)  T + kidx) * D + d);
                float qv, kv;
                if constexpr (FP8FORMAT == FP8E4M3) {
                    fp8e4m3 q8 = reinterpretcast<const fp8e4m3*>(Q)[qoff];
                    fp8e4m3 k8 = reinterpretcast<const fp8e4m3*>(K)[koff];
                    qv = fp8e4m3to_float(q8);
                    kv = fp8e4m3to_float(k8);
                } else {
                    fp8e5m2 q8 = reinterpretcast<const fp8e5m2*>(Q)[qoff];
                    fp8e5m2 k8 = reinterpretcast<const fp8e5m2*>(K)[koff];
                    qv = fp8e5m2to_float(q8);
                    kv = fp8e5m2to_float(k8);
                }
                dot += qv * kv;
            }
            score = dot * scale;
            if (causal && qidx < kidx) {
                score = -INFINITY;
            }
        }

        shared float scores_row[4096];
        if (q_idx < T) {
            scoresrow[qidx * T + k_idx] = score;
        }
        syncthreads();

        if (lane_id < T) {
            float row_max = -INFINITY;
            for (int n = 0; n < T; ++n) {
                float s = scoresrow[laneid * T + n];
                rowmax = fmaxf(rowmax, s);
            }
            float mnew = fmaxf(mi[laneid], rowmax);
            float expmdiff = expf(mi[laneid] - m_new);

            float lnew = expmdiff * li[lane_id];
            for (int n = 0; n < T; ++n) {
                float s = scoresrow[laneid * T + n];
                float e = expf(s - m_new);
                l_new += e;

                int v_off = (((b  H + h)  T + n) * D);
                for (int d = 0; d < D; ++d) {
                    float vv;
                    if constexpr (FP8FORMAT == FP8E4M3) {
                        fp8e4m3 v8 = reinterpretcast<const fp8e4m3*>(V)[voff + d];
                        vv = fp8e4m3to_float(v8);
                    } else {
                        fp8e5m2 v8 = reinterpretcast<const fp8e5m2*>(V)[voff + d];
                        vv = fp8e5m2to_float(v8);
                    }
                    acc[laneid  D + d] = (expmdiff  li[laneid]  acc[laneid  D + d] +
                                            e * vv) / l_new;
                }
            }
            mi[laneid] = m_new;
            li[laneid] = l_new;
        }
        syncthreads();
    }

    if (lane_id < T) {
        int qglobal = laneid;
        for (int d = 0; d < D; ++d) {
            int ooff = (((b  H + h)  T + qglobal) * D + d);
            O[ooff] = float2half(acc[laneid * D + d]);
        }
    }
}
