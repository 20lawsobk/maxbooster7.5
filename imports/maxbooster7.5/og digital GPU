from future import annotations
from typing import Dict, Any
from .execution_graph import ExecutionGraph
from .digital_gpu import DigitalGPU

class DigitalScheduler:
    def init(self, gpu: DigitalGPU) -> None:
        self._gpu = gpu

    def run(self, graph: ExecutionGraph, tensors: Dict[str, Any]) -> Dict[str, Any]:
        for node in graph.topological_order():
            result = self.gpu.runkernel(
                node.opcode,
                inputs={name: tensors[src] for name, src in node.inputs.items()},
            )
            for outname, tensorid in node.outputs.items():
                tensors[tensorid] = result[outname]
        return tensors
