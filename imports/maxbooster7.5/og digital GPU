from future import annotations
import numpy as np
from typing import Literal

FP8Format = Literal["e4m3", "e5m2"]

def quantize_fp8(x: np.ndarray, fmt: FP8Format) -> np.ndarray:
    if fmt == "e4m3":
        scale = 16.0
    else:
        scale = 8.0
    i = np.clip(np.round(x * scale), -128, 127).astype(np.int8)
    return i.view(np.uint8)

def dequantize_fp8(x: np.ndarray, fmt: FP8Format) -> np.ndarray:
    if fmt == "e4m3":
        scale = 16.0
    else:
        scale = 8.0
    i = x.view(np.int8).astype(np.float32)
    return i / scale

def fp8mixedmatmul(afp8: np.ndarray, bfp8: np.ndarray, fmt: FP8Format) -> np.ndarray:
    a = dequantizefp8(afp8, fmt)
    b = dequantizefp8(bfp8, fmt)
    acc = a.astype(np.float16) @ b.astype(np.float16)
    return acc.astype(np.float16)
