# ── Database (same Neon PostgreSQL as main app) ───────────────────────────────
DATABASE_URL=postgresql://neondb_owner:YOURPASSWORD@YOURHOST.neon.tech/neondb?sslmode=require

# ── Replit backend (the main Max Booster app) ─────────────────────────────────
# NEVER point this at max-booster.com — that would loop back through this proxy!
BACKEND_HOST=maxbooster.replit.app
BACKEND_PORT=443
BACKEND_USE_TLS=true

# ── Proxy listener ────────────────────────────────────────────────────────────
PROXY_PORT=443
PROXY_HOST=0.0.0.0

# ── Domain ────────────────────────────────────────────────────────────────────
BASE_DOMAIN=max-booster.com

# ── AES-256-GCM key (64 hex chars / 32 bytes) for cert decryption ─────────────
# Must match ACME_KEY_ENCRYPTION_KEY used by the main app.
# Leave blank to load from platform_settings table (same DB).
ACME_KEY_ENCRYPTION_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
