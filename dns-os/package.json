{
  "name": "dns-os",
  "version": "1.0.0",
  "private": true,
  "description": "Max Booster DNS Operating System — authoritative DNS provider + control plane",
  "workspaces": [
    "services/dns-api"
  ],
  "scripts": {
    "dev:api": "npm --workspace=services/dns-api run dev",
    "build:api": "npm --workspace=services/dns-api run build",
    "build:go": "cd services/dns-authoritative && go build -o bin/dns-authoritative .",
    "test": "echo 'No tests yet'",
    "migrate": "npm --workspace=services/dns-api run migrate",
    "compose:up": "docker compose -f infra/docker-compose.yml up --build",
    "compose:down": "docker compose -f infra/docker-compose.yml down"
  }
}
