# Version control
.git
.github
.github/

# IDEs and editors
.vscode
.idea

# Caches and runtime environments
.cache
node_modules/.cache
.next
.pythonlibs
.venv
__pycache__
.local/
.config/
.replit

# All npm packages — excluded entirely to keep the deployment layer small.
# The build command installs only production dependencies fresh in the
# deployment container. Pre-built dist/ artifacts skip the compile step.
node_modules/

# Large desktop/mobile app binary artifacts (not needed in web server deployment)
electron/
electron-out/
out/
release/
dist-installers/
dist-portable/
android/
ios/

# Rust build artifacts — exclude everything EXCEPT the pre-committed release binary
# at boosterstate/target/release/boosterstate (2.1 MB, committed to git).
# Excluding the whole target dir would force cargo build inside the container
# (which would fail — Rust is not installed there).
boosterstate/target/debug/
boosterstate/target/release/build/
boosterstate/target/release/deps/
boosterstate/target/release/examples/
boosterstate/target/release/incremental/
boosterstate/target/release/*.rlib
boosterstate/target/release/*.d
boosterstate/target/.fingerprint/
boosterstate/target/incremental/
boosterstate/target/build/
boosterstate/target/deps/
boosterstate/target/tmp/

# Old/legacy project copies and documentation
maxbooster7.5/
maxbooster_veo_music/
Max-Booster/
Max Booster final documentation/
AI training server/
pocket dimension storage tech/
built-in plugins dsp/

# Development and CI files
*.log
npm-debug.log*
logs/
.DS_Store
.nvmrc

# TypeScript build info cache
*.tsbuildinfo

# Tests and test output
test
tests
__tests__
*.test.ts
*.test.js
*.spec.ts
*.spec.js
coverage/
.nyc_output/
playwright-report/
test-results/
*.test.*
*.spec.*

# Documentation
docs/
design_guidelines.md
*.md
!replit.md

# Screenshots, videos, and large media assets not needed at runtime
client/public/screenshots
client/public/videos
generated-icon.png

# Generated content (regenerated at runtime via PDIM)
public/generated-content/

# Development tooling and agent config
scripts/
.agents/
attached_assets/

# Capacitor / mobile configs (not needed in deployment container)
capacitor.config.ts
capacitor.config.json
codemagic.yaml
ecosystem.config.js
watchdog.ps1
install_watchdog.ps1

# AI model training data (managed by MaxCore, not deployed here)
ai_model/
training/

# Data and storage (runtime-created, not deployment artifacts)
boostersheets_db/
boosterstate-data/
pocket-dimensions/
data/
uploads/

# Static assets source (already compiled into dist/public by Vite pre-build)
assets/

# Python/miscellaneous
pyproject.toml
uv.lock
main.py
cookies.txt
.audit-wal/
.capsule-temp/
storybook-static/
*.backup
