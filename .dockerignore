# Version control
.git
.github/

# Caches and runtime environments
.cache
.pythonlibs
.venv
__pycache__
.local/
.config/
.replit

# All npm packages — excluded entirely to keep the deployment layer small.
# The build command (npm install && npm run build) installs them fresh in the
# deployment container, so they are available at both build-time and runtime.
node_modules/

# Large desktop/mobile app binary artifacts (not needed for Cloud Run)
electron/
electron-out/

# Rust build artifacts (347MB)
boosterstate/target
boosterstate/src
boosterstate/Cargo.lock
boosterstate/Cargo.toml

# Old/legacy project copies (64MB)
maxbooster7.5/
maxbooster_veo_music/

# Development files
*.md
!replit.md
.env
.env.*
*.log
logs/
.DS_Store

# Screenshots, videos, and large media assets
client/public/screenshots
client/public/videos

# Generated content (36MB - regenerated at runtime)
public/generated-content/

# Development tooling
scripts/
.agents/
attached_assets/

# Test files only
*.test.*
*.spec.*

# Capacitor / mobile configs (not needed in deployment container)
capacitor.config.ts
capacitor.config.json

# Electron / Desktop / Mobile
electron/
electron-out/
out/
release/
dist-installers/
dist-portable/
android/
ios/

# AI model training data
ai_model/
training/

# Data and storage (runtime-created, not deployment artifacts)
boostsheets_db/
boosterstate-data/
pocket-dimensions/
data/
uploads/

# Documentation and tests
docs/
tests/

# Static assets source (already copied into dist/public by Vite)
assets/

# Misc
*.backup
cookies.txt
.audit-wal/
.capsule-temp/
