# Version control
.git
.github
.github/

# IDEs and editors
.vscode
.idea

# Caches and runtime environments
.cache
node_modules/.cache
.next
.pythonlibs
.venv
__pycache__
.local/
.config/
.replit

# All npm packages — excluded entirely to keep the deployment layer small.
# The build command installs only production dependencies fresh in the
# deployment container. Pre-built dist/ artifacts skip the compile step.
node_modules/

# Large desktop/mobile app binary artifacts (not needed in web server deployment)
electron/
electron-out/
out/
release/
dist-installers/
dist-portable/
android/
ios/

# Rust build artifacts — exclude the entire target directory including the
# compiled boosterstate binary. Replit's deployment layer push rejects ANY
# binary (non-UTF-8) file with "invalid UTF-8". The binary cannot be committed
# to git for the same reason, and compiling it during build only to have it
# rejected at layer-push time wastes ~60s for nothing. The app runs gracefully
# without the sidecar (start.sh has a built-in fallback).
boosterstate/target/

# Old/legacy project copies and documentation
maxbooster7.5/
maxbooster_veo_music/
Max-Booster/
Max Booster final documentation/
AI training server/
pocket dimension storage tech/
built-in plugins dsp/

# Development and CI files
*.log
npm-debug.log*
logs/
.DS_Store
.nvmrc

# TypeScript build info cache
*.tsbuildinfo

# Tests and test output
test
tests
__tests__
*.test.ts
*.test.js
*.spec.ts
*.spec.js
coverage/
.nyc_output/
playwright-report/
test-results/
*.test.*
*.spec.*

# Documentation
docs/
design_guidelines.md
*.md
!replit.md

# Screenshots, videos, and large media assets not needed at runtime
client/public/screenshots
client/public/videos
generated-icon.png

# Generated content (regenerated at runtime via PDIM)
public/generated-content/

# Development tooling and agent config
scripts/
.agents/
attached_assets/

# Capacitor / mobile configs (not needed in deployment container)
capacitor.config.ts
capacitor.config.json
codemagic.yaml
ecosystem.config.js
watchdog.ps1
install_watchdog.ps1

# AI model training data (managed by MaxCore, not deployed here)
ai_model/
training/

# Data and storage (runtime-created, not deployment artifacts)
boostersheets_db/
boosterstate-data/
pocket-dimensions/
data/
uploads/

# Source trees — fully pre-compiled into dist/ via fast-path build.
# Excluding these from the Docker COPY layer prevents 940+ MB of source code
# from being baked into the image base layer (where deletions in RUN steps
# still count toward total image size in UnionFS/overlay filesystems).
client/
server/
shared/
script/
scripts/

# Static assets source (already compiled into dist/public by Vite pre-build)
assets/

# Pre-compressed static asset variants (gzip + brotli) — binary files that are
# rejected by Replit's Repl-layer push with "invalid UTF-8". These are generated
# at dev-time by Vite's vite-plugin-compression and excluded from git by .gitignore,
# but they persist in the dev workspace between builds. The Node.js server serves
# the uncompressed originals when the .gz/.br variants are absent. Mirrors the
# existing .gitignore entries for dist/public/**/*.gz and dist/public/**/*.br.
dist/public/**/*.gz
dist/public/**/*.br

# Python/miscellaneous
pyproject.toml
uv.lock
main.py
cookies.txt
.audit-wal/
.capsule-temp/
storybook-static/
*.backup
