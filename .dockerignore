# Version control
.git
.github/

# Caches and runtime environments
.cache
.pythonlibs
.venv
__pycache__
.local/
.config/
.replit

# All npm packages — excluded entirely to keep the deployment layer small.
# The build command (npm install && npm run build:prod) installs them fresh in the
# deployment container, then prunes devDependencies after the build.
node_modules/

# Large desktop/mobile app binary artifacts (not needed in web server deployment)
electron/
electron-out/
out/
release/
dist-installers/
dist-portable/
android/
ios/

# Rust binary and all build artifacts (400MB+ when built)
boosterstate/

# Old/legacy project copies
maxbooster7.5/
maxbooster_veo_music/

# Development and CI files
*.md
!replit.md
.env
.env.*
*.log
logs/
.DS_Store
.nvmrc

# TypeScript build info cache
*.tsbuildinfo

# Test output and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
*.test.*
*.spec.*

# Screenshots, videos, and large media assets not needed at runtime
client/public/screenshots
client/public/videos

# Generated content (regenerated at runtime via PDIM)
public/generated-content/

# Development tooling and agent config
scripts/
.agents/
attached_assets/

# Capacitor / mobile configs (not needed in deployment container)
capacitor.config.ts
capacitor.config.json

# AI model training data (managed by MaxCore, not deployed here)
ai_model/
training/

# Data and storage (runtime-created, not deployment artifacts)
boostsheets_db/
boosterstate-data/
pocket-dimensions/
data/
uploads/

# Documentation and tests
docs/
tests/

# Static assets source (already compiled into dist/public by Vite pre-build)
assets/

# Misc
*.backup
cookies.txt
.audit-wal/
.capsule-temp/
storybook-static/
