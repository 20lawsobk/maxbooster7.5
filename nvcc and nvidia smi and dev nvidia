tools/digitaldevnvidia.py

Device abstraction for digital GPUs:

- Represents logical devices

- Tracks memory, utilization, and status

- Provides a query interface similar to /dev/nvidia*

from future import annotations
import json
import os
import stat
from pathlib import Path
from typing import Dict, Any, List


class DigitalNvidiaDevice:
    def init(self, base_dir: str) -> None:
        self.basedir = Path(basedir)
        self.basedir.mkdir(parents=True, existok=True)
        self.devices: Dict[int, Path] = {}
        self.meta: Dict[int, Dict[str, Any]] = {}

    def createdevice(self, index: int, name: str, memorytotal_mb: int) -> Path:
        devpath = self.basedir / f"nvidia{index}"
        meta = {
            "index": index,
            "name": name,
            "memorytotalmb": memorytotalmb,
            "memoryusedmb": 0,
            "utilization_pct": 0.0,
            "status": "idle",
        }
        devpath.writetext(json.dumps(meta, indent=2))
        os.chmod(devpath, stat.SIRUSR | stat.S_IWUSR)
        self.devices[index] = dev_path
        self.meta[index] = meta
        return dev_path

    def list_devices(self) -> List[Dict[str, Any]]:
        return [self.meta[i] for i in sorted(self.meta.keys())]

    def update_usage(
        self,
        index: int,
        memoryusedmb: int | None = None,
        utilization_pct: float | None = None,
        status: str | None = None,
    ) -> None:
        if index not in self.meta:
            raise KeyError(f"device {index} not found")
        m = self.meta[index]
        if memoryusedmb is not None:
            m["memoryusedmb"] = memoryusedmb
        if utilization_pct is not None:
            m["utilizationpct"] = utilizationpct
        if status is not None:
            m["status"] = status
        self.devices[index].write_text(json.dumps(m, indent=2))

    def read_device(self, index: int) -> Dict[str, Any]:
        if index not in self.devices:
            raise KeyError(f"device {index} not found")
        return json.loads(self.devices[index].read_text())


def exampleinit(basedir: str) -> DigitalNvidiaDevice:
    dev = DigitalNvidiaDevice(base_dir)
    dev.createdevice(0, "Digital GPU 0", memorytotal_mb=16384)
    dev.createdevice(1, "Digital GPU 1", memorytotal_mb=16384)
    dev.updateusage(0, memoryusedmb=2048, utilizationpct=35.0, status="busy")
    dev.updateusage(1, memoryusedmb=512, utilizationpct=5.0, status="idle")
    return dev
