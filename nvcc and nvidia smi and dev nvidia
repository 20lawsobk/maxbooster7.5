tools/digitalnvidiasmi.py

Telemetry + health view for digital GPU:

- Aggregates op measurements

- Computes totals and averages

- Exposes query interface

from future import annotations
import argparse
import json
from pathlib import Path
from typing import Any, Dict, List


def load_telemetry(path: Path) -> List[Dict[str, Any]]:
    data = json.loads(path.read_text())
    if not isinstance(data, list):
        raise TypeError("telemetry file must contain a list of measurements")
    return data


def summarize(ops: List[Dict[str, Any]]) -> Dict[str, Any]:
    total_flops = 0.0
    total_ms = 0.0
    total_bytes = 0
    for m in ops:
        total_flops += float(m.get("flops", 0.0))
        totalms += float(m.get("durationms", 0.0))
        totalbytes += int(m.get("bytesmoved", 0))
    avgms = totalms / len(ops) if ops else 0.0
    return {
        "count": len(ops),
        "totalflops": totalflops,
        "totalms": totalms,
        "avgms": avgms,
        "totalbytes": totalbytes,
    }


def print_default(ops: List[Dict[str, Any]]) -> None:
    summary = summarize(ops)
    print("+-----------------------------------------------------------------------------+")
    print("| Digital NVIDIA-SMI            Backend: digital_gpu          Version: 1.1.0  |")
    print("+-------------------------------+----------------------+----------------------+")
    print("| Opcode                        | Duration (ms)        | FLOPs               |")
    print("+-------------------------------+----------------------+----------------------+")
    for m in ops:
        print(
            f"| {m.get('opcode',''): <29} | "
            f"{float(m.get('duration_ms',0.0)): >20.3f} | "
            f"{float(m.get('flops',0.0)): >20.3e} |"
        )
    print("+-------------------------------+----------------------+----------------------+")
    print(f"| Total ops: {summary['count']: <6}  Total ms: {summary['total_ms']: >10.3f}  "
          f"Total FLOPs: {summary['total_flops']: >12.3e} |")
    print(f"| Avg ms/op: {summary['avgms']: >10.3f}  Total bytes moved: {summary['totalbytes']: >12d} |")
    print("+-----------------------------------------------------------------------------+")


def print_query(ops: List[Dict[str, Any]], fields: List[str]) -> None:
    for m in ops:
        row = []
        for f in fields:
            row.append(str(m.get(f, "N/A")))
        print(",".join(row))


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="digital-nvidia-smi",
        description="Digital GPU telemetry and health viewer",
    )
    parser.add_argument("--telemetry", required=True, help="Telemetry JSON file")
    parser.add_argument(
        "--query-op",
        dest="query",
        help="Comma-separated fields (e.g. opcode,durationms,flops,bytesmoved)",
    )
    args = parser.parse_args()

    ops = load_telemetry(Path(args.telemetry))
    if not args.query:
        print_default(ops)
    else:
        fields = [f.strip() for f in args.query.split(",") if f.strip()]
        print_query(ops, fields)


if name == "main":
    main()
