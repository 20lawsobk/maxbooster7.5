tools/digital_nvcc.py

Theoretical "compiler" for digital GPU kernels:

- Validates kernel specs

- Resolves dependencies

- Builds an opcode registry

- Performs simple static checks

from future import annotations
import argparse
import json
import sys
from pathlib import Path
from typing import Dict, Any, List, Tuple


REQUIRED_FIELDS = {
    "name": str,
    "opcode": str,
    "version": int,
    "inputs": dict,
    "outputs": dict,
    "dtypes": dict,
    "numeric_profile": str,
    "deterministic": bool,
    "doc": str,
}


def validate_types(spec: Dict[str, Any], src: Path) -> None:
    for field, expectedtype in REQUIREDFIELDS.items():
        if field not in spec:
            raise ValueError(f"{src}: missing required field '{field}'")
        if not isinstance(spec[field], expected_type):
            raise TypeError(
                f"{src}: field '{field}' expected {expectedtype.name_}, "
                f"got {type(spec[field]).name}"
            )


def validate_shapes(spec: Dict[str, Any], src: Path) -> None:
    inputs = spec["inputs"]
    outputs = spec["outputs"]
    if not inputs:
        raise ValueError(f"{src}: kernel must have at least one input")
    if not outputs:
        raise ValueError(f"{src}: kernel must have at least one output")
    for name, shape in inputs.items():
        if not isinstance(shape, list) or not all(isinstance(s, str) for s in shape):
            raise TypeError(f"{src}: input '{name}' shape must be list[str]")
    for name, shape in outputs.items():
        if not isinstance(shape, list) or not all(isinstance(s, str) for s in shape):
            raise TypeError(f"{src}: output '{name}' shape must be list[str]")


def validate_dtypes(spec: Dict[str, Any], src: Path) -> None:
    dtypes = spec["dtypes"]
    allowed = {"fp32", "fp16", "bf16", "fp8", "int32", "int64"}
    for name, dt in dtypes.items():
        if dt not in allowed:
            raise ValueError(f"{src}: dtype '{dt}' for '{name}' not in {sorted(allowed)}")


def validatenumericprofile(spec: Dict[str, Any], src: Path) -> None:
    allowed = {"fp32strict", "fp16mixed", "fp8_mixed"}
    if spec["numeric_profile"] not in allowed:
        raise ValueError(
            f"{src}: numericprofile '{spec['numericprofile']}' not in {sorted(allowed)}"
        )


def compilekernelspec(src: Path) -> Dict[str, Any]:
    spec = json.loads(src.read_text())
    validate_types(spec, src)
    validate_shapes(spec, src)
    validate_dtypes(spec, src)
    validatenumericprofile(spec, src)
    return spec


def build_registry(specs: List[Dict[str, Any]]) -> Dict[str, Any]:
    registry: Dict[str, Any] = {}
    for spec in specs:
        opcode = spec["opcode"]
        version = spec["version"]
        key = f"{opcode}:v{version}"
        if key in registry:
            raise ValueError(f"duplicate opcode version: {key}")
        registry[key] = spec
    return registry


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="digital-nvcc",
        description="Digital GPU kernel compiler and registry builder",
    )
    parser.add_argument("inputs", nargs="+", help="Kernel spec JSON files")
    parser.add_argument("-o", "--output", required=True, help="Output registry file (.json)")
    args = parser.parse_args()

    specs: List[Dict[str, Any]] = []
    for inp in args.inputs:
        spec = compilekernelspec(Path(inp))
        specs.append(spec)

    registry = build_registry(specs)
    Path(args.output).write_text(json.dumps(registry, indent=2))
    print(f"digital-nvcc: wrote registry with {len(registry)} entries to {args.output}")


if name == "main":
    main()
