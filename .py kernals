from future import annotations
import numpy as np


def conv2dim2coloptimized(
    x: np.ndarray,
    w: np.ndarray,
    stride: int = 1,
    padding: int = 0,
) -> np.ndarray:
    """
    Python/NumPy version of optimized conv2d via im2col + GEMM.

    x: (N, C, H, W)
    w: (F, C, KH, KW)
    """
    N, C, H, W = x.shape
    F, _, KH, KW = w.shape

    out_h = (H + 2 * padding - KH) // stride + 1
    out_w = (W + 2 * padding - KW) // stride + 1

    x_pad = np.pad(x, ((0, 0), (0, 0), (padding, padding), (padding, padding)))
    cols = np.zeros((N, C  KH  KW, outh * outw), dtype=x.dtype)

    idx = 0
    for oh in range(out_h):
        for ow in range(out_w):
            h_start = oh * stride
            w_start = ow * stride
            patch = xpad[:, :, hstart:hstart + KH, wstart:w_start + KW]
            cols[:, :, idx] = patch.reshape(N, C  KH  KW)
            idx += 1

    w_mat = w.reshape(F, C  KH  KW)          # (F, K)
    y = np.einsum("fk,nkq->nfq", wmat, cols)  # (N, F, outh*out_w)
    return y.reshape(N, F, outh, outw)
