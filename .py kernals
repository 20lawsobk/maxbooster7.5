from future import annotations
import numpy as np


def reduction_optimized(x: np.ndarray, y: np.ndarray) -> float:
    """
    Python/NumPy version of optimized reduction:
    Computes sum_i x[i] * y[i] with good cache behavior.
    """
    if x.shape != y.shape:
        raise ValueError("x and y must have the same shape")
    # vectorized dot product is already optimal in NumPy
    return float(np.dot(x.ravel(), y.ravel()))
