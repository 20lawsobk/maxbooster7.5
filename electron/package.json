{
  "name": "max-booster-electron",
  "version": "3.0.0",
  "description": "Max Booster Desktop App",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "B-Lawz Music",
    "email": "blawzmusic@gmail.com"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "com.blawzmusic.maxbooster",
    "productName": "Max Booster",
    "asar": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "files": [
      "**/*",
      "!package-lock.json",
      "!assets/entitlements.mac.plist"
    ],
    "extraResources": [
      {
        "from": "../dist/public",
        "to": "dist/public",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "../dist-installers",
      "buildResources": "assets"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "icon": "assets/icon.png",
      "category": "Audio",
      "maintainer": "B-Lawz Music <blawzmusic@gmail.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blawzmusic",
        "repo": "max-booster",
        "releaseType": "release"
      }
    ]
  }
}
